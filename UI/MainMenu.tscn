theme_override_font_sizes/font_size = 16
text = "FLIGHT\nW — pitch up / throttle up\nS — pitch down / throttle down\nA / D — yaw left / right\nQ / E — roll left / right\nShift — boost\nSpace — fire\n\nDEFENSE\nB — open build menu\n1 / 2 — select gun / missile station\nEnter — place station\nEsc — cancel / pause\nR — retry after defeat\n\nOBJECTIVE\nDefend the Sector Core.\nDestroy all 10 enemy shipyards to win."
